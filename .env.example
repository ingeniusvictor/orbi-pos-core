# ORBI POS payment provider
# Default and safest for development:
ORBI_PAYMENT_PROVIDER=mock

# To enable the real Mercado Pago Point adapter later:
# ORBI_PAYMENT_PROVIDER=mercadopago
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR_REPLACE_ME
# ORBI_POINT_TERMINAL_ID=NEWLAND_N950__REPLACE_WITH_REAL_SERIAL
# ORBI_POINT_TERMINAL_LABEL=Point Smart 2 - Caja principal
# ORBI_POINT_STORE_ID=
# ORBI_POINT_POS_ID=

# Optional host/server settings
# PORT=8787
# HOST=0.0.0.0
# ORBI_POS_DATA_DIR=/absolute/path/to/orbi-pos-data
